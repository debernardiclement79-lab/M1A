# Copier vers ~/.config/m1a/server.env (permissions 600).
# Pas de clé réelle dans ce fichier modèle.
HOST=127.0.0.1
PORT=3000
# Utiliser l'origine HTTPS exacte lorsque l'accès distant est configuré.
PUBLIC_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=0
# Renseigner dans la session locale. Laisser vide pour la démonstration.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
